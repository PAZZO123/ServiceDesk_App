ENVIRONMENT=development
DEBUG=true
SECRET_KEY=generate-with-secrets-token-urlsafe-48
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_TOKEN_EXPIRE_HOURS=24
RESET_TOKEN_EXPIRE_MINUTES=30

POSTGRES_USER=servicedesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=servicedesk
DATABASE_URL=postgresql+asyncpg://servicedesk:change-me@localhost:5432/servicedesk
TEST_DATABASE_URL=postgresql+asyncpg://servicedesk:change-me@localhost:5432/servicedesk_test

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=you@example.com
MAIL_FROM_NAME=ServiceDesk

