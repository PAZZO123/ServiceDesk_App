ENVIRONMENT=development
DEBUG=true
SECRET_KEY=generate-with-secrets-token-urlsafe-48
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_TOKEN_EXPIRE_HOURS=24
RESET_TOKEN_EXPIRE_MINUTES=30

POSTGRES_USER=servicedesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=servicedesk
# 127.0.0.1, not localhost: docker-compose publishes the ports on IPv4
# loopback only, and Windows tries "localhost" as IPv6 (::1) first.
# 5433: the host port in docker-compose.yml (5432 is a local PostgreSQL).
DATABASE_URL=postgresql+asyncpg://servicedesk:change-me@127.0.0.1:5433/servicedesk
TEST_DATABASE_URL=postgresql+asyncpg://servicedesk:change-me@127.0.0.1:5433/servicedesk_test

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=you@example.com
MAIL_FROM_NAME=ServiceDesk

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000